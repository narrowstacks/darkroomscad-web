{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", "tsconfig.json"],
  // Turbo folds VERCEL_ANALYTICS_ID and VERCEL_TARGET_ENV into the global hash by
  // default. The analytics id is a legacy per-deployment value nothing here reads,
  // so it made every Vercel build a miss; the target env would only keep preview and
  // production from sharing a cache for output that does not depend on it.
  "globalEnv": ["!VERCEL_ANALYTICS_ID", "!VERCEL_TARGET_ENV"],
  //
  // Framework inference: turbo sees Next.js in this package and adds NEXT_PUBLIC_*,
  // NEXT_DEPLOYMENT_ID and (with Skew Protection on) VERCEL_DEPLOYMENT_ID to EVERY
  // task's hash. On Vercel the deployment ids and NEXT_PUBLIC_VERCEL_URL /
  // _GIT_COMMIT_SHA / ... change per deployment, so tasks that never read them opt
  // out entirely. `build` keeps NEXT_DEPLOYMENT_ID (it is baked into the bundle, so
  // with Skew Protection on `build` never cache-hits on Vercel — expected) and negates
  // just the per-deployment NEXT_PUBLIC_VERCEL_* names: a wildcard negation would also
  // drop NEXT_PUBLIC_VERCEL_OBSERVABILITY_*, which @vercel/analytics + speed-insights
  // read, and a positive entry does not survive a matching negation.
  "tasks": {
    "gen:base-stls": {
      "inputs": [
        "scripts/gen-base-stls.ts",
        "scripts/lib/scad-harness.ts",
        "scripts/lib/carrier-specs.ts",
        "public/scad/**",
        "public/libraries/**",
        "public/wasm/**"
      ],
      "outputs": ["public/base-stls/**"],
      "env": ["!NEXT_PUBLIC_*", "!NEXT_DEPLOYMENT_ID", "!VERCEL_DEPLOYMENT_ID"]
    },
    "build": {
      "dependsOn": ["gen:base-stls"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!docs/**",
        "!.github/**",
        "!.claude/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!vitest.config.ts"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      // NEXT_DEPLOYMENT_ID is baked into the client bundle when Skew Protection is on.
      // next only reads VERCEL_ENV / VERCEL_URL / VERCEL_BRANCH_URL for metadataBase,
      // which this app does not use (no relative OG/Twitter image URLs) — add them to
      // `env` if that changes.
      "env": [
        "NEXT_DEPLOYMENT_ID",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "!NEXT_PUBLIC_VERCEL_URL",
        "!NEXT_PUBLIC_VERCEL_BRANCH_URL",
        "!NEXT_PUBLIC_VERCEL_DEPLOYMENT_ID",
        "!NEXT_PUBLIC_VERCEL_ENV",
        "!NEXT_PUBLIC_VERCEL_TARGET_ENV",
        "!NEXT_PUBLIC_VERCEL_GIT_*"
      ],
      "passThroughEnv": ["VERCEL", "VERCEL_ENV", "VERCEL_URL", "VERCEL_BRANCH_URL", "VERCEL_GIT_*", "CI"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "!.github/**", "!.claude/**", "!public/**", "public/wasm/openscad.d.ts"],
      "outputs": [],
      "env": ["!NEXT_PUBLIC_*", "!NEXT_DEPLOYMENT_ID", "!VERCEL_DEPLOYMENT_ID"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "!.github/**", "!.claude/**", "!public/**", "public/wasm/openscad.d.ts"],
      "outputs": [],
      "env": ["!NEXT_PUBLIC_*", "!NEXT_DEPLOYMENT_ID", "!VERCEL_DEPLOYMENT_ID"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**", "!.github/**", "!.claude/**"],
      "outputs": [],
      "env": ["!NEXT_PUBLIC_*", "!NEXT_DEPLOYMENT_ID", "!VERCEL_DEPLOYMENT_ID"]
    }
  }
}
