    },
    {
      "name": "Peg_Gap",
      "section": "Adjustments",
      "type": "number",
      "default": 0,
      "hidden": false,
      "description": "Leave at 0 for default gap. Measured in mm. Add positive values to increase the gap between pegs and film edge, subtract (use negative values) to decrease it. Default 0 allows for little wiggle."
    },
    {
      "name": "Adjust_Film_Width",
      "section": "Adjustments",
      "type": "number",
      "default": 0,
      "hidden": false,
      "description": "Leave at 0 for no adjustment. Measured in mm. Add positive values to increase the film width, subtract (use negative values) to decrease it."
    },
    {
      "name": "Adjust_Film_Height",
      "section": "Adjustments",
      "type": "number",
      "default": 0,
      "hidden": false,
      "description": "Leave at 0 for no adjustment. Measured in mm. Add positive values to increase the film height, subtract (use negative values) to decrease it."
    },
    {
      "name": "Render_Quality",
      "section": "Render Quality",
      "type": "enum",
      "default": "final",
      "hidden": false,
      "description": "Use \"preview\" for faster F5 preview, \"final\" for smooth F6 renders",
      "options": [
        {
          "value": "final",
          "label": "final"
        },
        {
          "value": "preview",
          "label": "preview"
        }
      ]
    },
    {
      "name": "$fn",
      "section": "Hidden",
      "type": "string",
      "default": "(Render_Quality == \"final\") ? 100 : 32",
      "hidden": true,
      "description": "Variable resolution: 32 for preview speed, 100 for final quality"
    },
    {
      "name": "carrier_config",
      "section": "Hidden",
